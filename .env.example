# The complete set of environment variables src/configuration.ts requires at
# startup, with dummy values. The Kafka consumer group id is deliberately not
# here: it's a hardcoded application default (biblioteca_server_consumer,
# src/configuration.ts), the same in every environment.
KAFKA_SERVERS=kafka.local:9092
STS_SERVER=http://sts.local:11200
OLLAMA_SERVER=http://ollama.local:11434
MINI_MILVUS=milvus.local:20112
TEXTBASE_URL=http://biblioteca.local:8080
