# The complete set of environment variables src/configuration.ts requires at
# startup, with dummy values - the shared pass-store names the whole
# Biblioteca family uses. The Kafka consumer group id is deliberately not
# here: it's a hardcoded application default (biblioteca_nestjs,
# src/configuration.ts), the same in every environment.
KAFKA_BROKERS=kafka.local:9092
STS_SERVER=http://sts.local:11200
OLLAMA_SERVER=http://ollama.local:11434
MILVUS_URL=milvus.local:20112
BIBLIOTECA_EXTERNAL_URL=http://biblioteca.local:8080
